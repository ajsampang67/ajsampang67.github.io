alias japanese-alfred='echo ア ル フレド　サンパンぐ'
alias cstart='./catalina.sh jpda run'
alias cd-cstart='cd bundles/tomcat*/bin'
alias xc='xclip -selection clipboard'
alias gcd='gw clean deploy'
alias gd='gw deploy'
alias gfs='gw formatSource'
alias gstat='git status -uno' 
alias cplicensecommerce='cp ~/projects/liferay/licenses/activation-key-commercesubscriptiondevelopment-1-liferaycom.xml .'
alias cplicense73='cp ~/projects/liferay/licenses/activation-key-digitalenterprisedevelopment-7.3-liferaycom.xml .'
alias cplicense72='cp ~/projects/liferay/licenses/activation-key-digitalenterprisedevelopment-7.2-liferaycom.xml .'
alias cplicense71='cp ~/projects/liferay/licenses/activation-key-digitalenterprisedevelopment-7.1-liferaycom.xml .'
alias cplicense70='cp ~/projects/liferay/licenses/activation-key-digitalenterprisedevelopment-7.0-liferaycom.xml .'
alias cpprop='cp ~/projects/liferay/portal-ext.properties .'
alias cpmysql='cp ~/projects/liferay/mysql.jar .'
alias git='hub'
alias gogo='telnet localhost 11311'
alias gpull='git pull origin master'
alias emptytrash='sudo rm -rf ~/.local/share/Trash/*'
alias gh="xdg-open \`git remote -v | grep fetch | head -1 | cut -f2 | cut -d' ' -f1 | sed -e's/git@/http:\/\//' -e's/\.git$//' | sed -E 's/(\/\/[^:]*):/\1\//'\`"
alias glog='git log -5 --graph --decorate --abbrev-commit'
alias mileageplus='echo YU619197'
alias open='xdg-open'
alias brrr='redshift -O 6500'
alias heat='redshift -O 4500'
alias rls='ls -Rla'
alias unzip-70x='unzip ~/Downloads/liferay-portal-tomcat-7.0.x-private-all.zip && rm ~/Downloads/liferay-portal-tomcat-7.0.x-private-all* .'
alias unzip-71x='unzip ~/Downloads/liferay-portal-tomcat-7.1.x-private-all.zip && rm ~/Downloads/liferay-portal-tomcat-7.1.x-private-all* .'
alias unzip-72x='unzip ~/Downloads/liferay-portal-tomcat-7.2.x-private-all.zip && rm ~/Downloads/liferay-portal-tomcat-7.2.x-private-all* .'
alias shrug='echo "¯\_(ツ)_/¯" | xc'
alias docker-stop-all-containers='docker stop $(docker ps -a -q)'
alias docker-rm-all-containers='docker rm $(docker ps -a -q)'
alias mysql-start='docker run mysql/mysql-server:5.7'
alias kill-tomcat="pkill -9 -f 'java.*tomcat.*start'"
alias clean-portal="rm -rf ../../data/hypersonic/* ../../osgi/state/*"
alias jenkins-start="docker run -d -p 8085:8085 -p 50000:50000 -v jenkins_home:/var/jenkins_home jenkins"
